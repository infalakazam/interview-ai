# Use the OAuth 2.0 Web Client ID from Google Cloud. Never put a client secret here.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# PostgreSQL connection string. Without it, practice history stays in this browser.
DATABASE_URL=postgresql://username:password@host:5432/database_name
# Use a long random secret (at least 32 characters) to sign history-sync sessions.
SESSION_SECRET=replace-with-a-long-random-secret
